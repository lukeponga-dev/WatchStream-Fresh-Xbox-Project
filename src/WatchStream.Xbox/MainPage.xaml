<Page
  x:Class="WatchStream.Xbox.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="using:WatchStream.Xbox.Converters"
  Background="#05080F"
  Foreground="#F4F6FB"
  Loaded="Page_Loaded"
>
  <Page.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#9BEA38" />
    <SolidColorBrush x:Key="GlassBrush" Color="#CC121824" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9BA5B5" />

    <!-- Cinematic Nav Style -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D9DFE9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="Focused">
                      <Storyboard>
                          <DoubleAnimation
                              Storyboard.TargetName="Indicator"
                              Storyboard.TargetProperty="Width"
                              To="6"
                              Duration="0:0:0.2"/>
                      </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,2">
                <Grid>
                  <Rectangle x:Name="Indicator" Width="0" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}" />
                  <ContentPresenter Margin="20,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CinematicCardButtonStyle" TargetType="Button">
      <Setter Property="UseSystemFocusVisuals" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="Focused">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.2"/>
                      <ColorAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#9BEA38" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Glow" BorderBrush="#9BEA38" BorderThickness="3" CornerRadius="12" Opacity="0" Margin="5"/>
              <Grid x:Name="CardContent" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <ContentPresenter />
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid XYFocusKeyboardNavigation="Enabled">
    <!-- 1. Background Layer: Cinematic Backdrop -->
    <Grid>
      <Image x:Name="HeroBackdrop" Stretch="UniformToFill" Opacity="0.4" />
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#05080F" Offset="0.0" />
            <GradientStop Color="Transparent" Offset="1.0" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>

    <!-- 2. Content Layer: Horizontal Rows -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="60,0,60,0" Spacing="40" Padding="0,80,0,80">
        
        <!-- Hero Section -->
        <Grid Height="450" VerticalAlignment="Top">
          <StackPanel VerticalAlignment="Bottom" Spacing="12" MaxWidth="600">
            <TextBlock Text="FEATURED" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" CharacterSpacing="200"/>
            <TextBlock x:Name="HeroTitle" Text="Welcome to WatchStream" FontSize="56" FontWeight="Bold" LineHeight="64" TextWrapping="Wrap"/>
            <TextBlock x:Name="HeroDesc" Text="Experience your library in cinematic quality." FontSize="18" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
               <Button Content="▶ Play Now" Background="{StaticResource AccentBrush}" Foreground="#000" FontWeight="Bold" Padding="24,12" CornerRadius="8" MinWidth="160"/>
               <Button Content="More Info" Background="#33FFFFFF" Foreground="#FFF" Padding="24,12" CornerRadius="8" MinWidth="160"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- Content Rows (Dynamic) -->
        <StackPanel Spacing="24">
          <TextBlock Text="Continue Watching" FontSize="24" FontWeight="SemiBold" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Left">
             <ItemsControl x:Name="ContinueRow">
               <ItemsControl.ItemsPanel>
                 <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="20"/></ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
               <ItemsControl.ItemTemplate>
                 <DataTemplate>
                   <Button Style="{StaticResource CinematicCardButtonStyle}" Click="HomeMediaCard_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" Width="180" Height="260">
                     <Grid>
                       <Image Source="{Binding Poster, Converter={StaticResource PosterConverter}}" Stretch="UniformToFill" Width="180" Height="260"/>
                       <Border Background="#99000000" VerticalAlignment="Bottom" Height="60" CornerRadius="0,0,12,12" Padding="12,0,12,0">
                         <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                       </Border>
                     </Grid>
                   </Button>
                 </DataTemplate>
               </ItemsControl.ItemTemplate>
             </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <StackPanel Spacing="24">
          <TextBlock Text="Trending Now" FontSize="24" FontWeight="SemiBold" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Left">
             <ItemsControl x:Name="TrendingRow">
               <ItemsControl.ItemsPanel>
                 <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="20"/></ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
               <ItemsControl.ItemTemplate>
                 <DataTemplate>
                   <Button Style="{StaticResource CinematicCardButtonStyle}" Click="HomeMediaCard_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" Width="180" Height="260">
                     <Grid>
                       <Image Source="{Binding Poster, Converter={StaticResource PosterConverter}}" Stretch="UniformToFill" Width="180" Height="260"/>
                       <Border Background="#99000000" VerticalAlignment="Bottom" Height="60" CornerRadius="0,0,12,12" Padding="12,0,12,0">
                         <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                       </Border>
                     </Grid>
                   </Button>
                 </DataTemplate>
               </ItemsControl.ItemTemplate>
             </ItemsControl>
          </ScrollViewer>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- 3. Overlay Layer: Slide-out Navigation -->
    <Border x:Name="NavOverlay" Width="300" HorizontalAlignment="Left" Background="{StaticResource GlassBrush}" 
            BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0" CornerRadius="0,20,20,0"
            Translation="0,0,20"  Opacity="0">
      <Grid Margin="20,40,20,20">
        <StackPanel Spacing="8">
          <TextBlock Text="WATCHSTREAM" FontSize="20" FontWeight="Bold" Margin="12,0,0,30" CharacterSpacing="100" Foreground="{StaticResource AccentBrush}"/>
          <Button Content="Home" Style="{StaticResource NavButtonStyle}" Click="HomeNavButton_Click" TabIndex="0"/>
          <Button Content="Discover" Style="{StaticResource NavButtonStyle}" Click="DiscoverButton_Click" TabIndex="1"/>
          <Button Content="My Library" Style="{StaticResource NavButtonStyle}" Click="LibraryButton_Click" TabIndex="2"/>
          <Button Content="Series" Style="{StaticResource NavButtonStyle}" Click="SeriesButton_Click" TabIndex="3"/>
          <Button Content="Search" Style="{StaticResource NavButtonStyle}" Click="SearchButton_Click" TabIndex="4"/>
          <Border Height="1" Background="#20FFFFFF" Margin="12,20,12,20"/>
          <Button Content="Add-ons" Style="{StaticResource NavButtonStyle}" Click="AddonsButton_Click" TabIndex="5"/>
          <Button Content="Settings" Style="{StaticResource NavButtonStyle}" Click="SettingsButton_Click" TabIndex="6"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
