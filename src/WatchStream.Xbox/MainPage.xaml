<Page
    x:Class="WatchStream.Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WatchStream.Xbox"
    xmlns:converters="using:WatchStream.Xbox.Converters"
    Background="#050B1B"
    Foreground="#F4F6FB"
    Loaded="Page_Loaded">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#E50914"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA8C7"/>
        <converters:PosterImageConverter x:Key="PosterConverter"/>
        <Style x:Key="HomeCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#101F3A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="CardBorder" BorderBrush="#244269" BorderThickness="1" CornerRadius="12" Background="{TemplateBinding Background}"><ContentPresenter/></Border><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="Focused"><Storyboard><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.15"/><DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.15"/><ColorAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E50914" Duration="0:0:0.15"/></Storyboard></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><Grid.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeroButtonStyle" TargetType="Button"><Setter Property="MinHeight" Value="54"/><Setter Property="Padding" Value="24,12"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="UseSystemFocusVisuals" Value="False"/></Style>
    </Page.Resources>

    <Grid XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NavigationSidebar Grid.Column="0" CurrentSection="Home"/>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="34" Padding="38,30,38,34">
                    <Grid Height="390" CornerRadius="18">
                        <Image x:Name="HeroBackdrop" Stretch="UniformToFill" Opacity="0.5"/>
                        <Border CornerRadius="18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#071226" Offset="0"/><GradientStop Color="#DD071226" Offset="0.55"/><GradientStop Color="#FF050B1B" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <StackPanel VerticalAlignment="Bottom" MaxWidth="720" Spacing="14" Margin="32,28">
                            <Border Background="#25E50914" CornerRadius="5" Padding="10,5" HorizontalAlignment="Left"><TextBlock Text="YOUR STREAMING UNIVERSE" FontSize="11" FontWeight="Bold" Foreground="#39D6C5" CharacterSpacing="120"/></Border>
                            <TextBlock Text="YOUR NEXT GREAT STORY STARTS HERE" FontSize="12" Foreground="#9BA8C7" CharacterSpacing="160"/>
                            <TextBlock x:Name="HeroTitle" Text="What will you watch tonight?" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2"/>
                            <TextBlock x:Name="HeroDesc" Text="Explore your library, discover something new, and settle in for a great story." FontSize="17" Foreground="#D0D8E8" TextWrapping="Wrap" MaxLines="3"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Button x:Name="HeroPlayButton" Content="PLAY  |  EXPLORE" Click="HeroPlayButton_Click" Style="{StaticResource HeroButtonStyle}" Background="#E50914" Foreground="#06121D"/>
                                <Button Content="MY LIST  |  LIBRARY" Click="HeroInfoButton_Click" Style="{StaticResource HeroButtonStyle}" Background="#172B4A" Foreground="White" BorderBrush="#35537B" BorderThickness="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="Continue exploring" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Pick up where you left off" FontSize="13" Foreground="#9BA8C7"/></StackPanel><Button Grid.Column="1" Content="OPEN LIBRARY  ├óΓÇáΓÇÖ" Click="HeroInfoButton_Click" Background="Transparent" Foreground="#39D6C5" BorderThickness="0" VerticalAlignment="Center"/></Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="ContinueRow"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardStyle}" Width="170" Height="245" Click="HomeMediaCard_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"><Grid><Image Source="{Binding Poster, Converter={StaticResource PosterConverter}}" Stretch="UniformToFill"/><Border Background="#DD071226" VerticalAlignment="Bottom" Padding="12" CornerRadius="0,0,12,12"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{Binding Year}" FontSize="11" Foreground="#39D6C5"/></StackPanel></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </StackPanel>
                    <StackPanel Spacing="14">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="More to discover" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Explore more from your connected add-ons" FontSize="13" Foreground="#9BA8C7"/></StackPanel><Button Grid.Column="1" Content="DISCOVER ALL  ├óΓÇáΓÇÖ" Click="HeroPlayButton_Click" Background="Transparent" Foreground="#39D6C5" BorderThickness="0" VerticalAlignment="Center"/></Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="TrendingRow"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HomeCardStyle}" Width="170" Height="245" Click="HomeMediaCard_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"><Grid><Image Source="{Binding Poster, Converter={StaticResource PosterConverter}}" Stretch="UniformToFill"/><Border Background="#DD071226" VerticalAlignment="Bottom" Padding="12" CornerRadius="0,0,12,12"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{Binding Year}" FontSize="11" Foreground="#39D6C5"/></StackPanel></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </StackPanel>
                    <Border Background="#0B1830" BorderBrush="#1B3457" BorderThickness="1" CornerRadius="12" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Your entertainment, all in one place" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Connect Stremio to bring your add-ons and library together." FontSize="13" Foreground="#9BA8C7" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="SIGN IN" Click="ConnectButton_Click" Background="#5268FF" Foreground="White" Padding="16,10" BorderThickness="0" VerticalAlignment="Center"/></Grid></Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="#07142A" BorderBrush="#183B70" BorderThickness="0,1,0,0" Padding="24,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="WATCHSTREAM  |  YOUR MEDIA, YOUR WAY" FontSize="10" Foreground="#7181A2" CharacterSpacing="80" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="D-PAD / LEFT STICK     A SELECT  |  B BACK" FontSize="10" Foreground="#7181A2" VerticalAlignment="Center"/></Grid></Border>
        </Grid>
    </Grid>
</Page>
