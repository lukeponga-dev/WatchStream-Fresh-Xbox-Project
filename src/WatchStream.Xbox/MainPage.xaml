<Page
    x:Class="WatchStream.Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#050B1B" Foreground="#F5F7FF" Loaded="Page_Loaded">
    <Grid Padding="24,20,24,18" ColumnSpacing="20" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#07142A" BorderBrush="#183B70" BorderThickness="1" CornerRadius="18" Padding="13">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#39D6C5"><TextBlock Text="▶" FontSize="20" FontWeight="Bold" Foreground="#07111D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="WATCHSTREAM" FontSize="15" FontWeight="Bold" CharacterSpacing="45"/><TextBlock Text="YOUR MEDIA, YOUR WAY" FontSize="8" Foreground="#9BA8C7" CharacterSpacing="55"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="7">
                    <TextBlock Text="MENU" FontSize="10" FontWeight="Bold" Foreground="#7181A2" CharacterSpacing="140" Margin="10,0,0,4"/>
                    <Button x:Name="HomeNavButton" Content="⌂   Home" Click="HomeNavButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" FontSize="15" Background="#3420A7" Foreground="#FFFFFF" TabIndex="0" UseSystemFocusVisuals="True"/>
                    <Button x:Name="DiscoverButton" Content="✦   Discover" Click="DiscoverButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" FontSize="15" Background="#101F3A" Foreground="#F5F7FF" TabIndex="1" UseSystemFocusVisuals="True"/>
                    <Button x:Name="LibraryButton" Content="▤   Library" Click="LibraryButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" FontSize="15" Background="#101F3A" Foreground="#F5F7FF" TabIndex="2" UseSystemFocusVisuals="True"/>
                    <Button x:Name="AddonsButton" Content="▦   Add-ons" Click="AddonsButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" FontSize="15" Background="#101F3A" Foreground="#F5F7FF" TabIndex="3" UseSystemFocusVisuals="True"/>
                    <Button x:Name="SearchButton" Content="⌕   Search" Click="SearchButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" FontSize="15" Background="#101F3A" Foreground="#F5F7FF" TabIndex="4" UseSystemFocusVisuals="True"/>
                    <Button x:Name="SettingsButton" Content="⚙   Settings" Click="SettingsButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" FontSize="15" Background="#101F3A" Foreground="#F5F7FF" TabIndex="5" UseSystemFocusVisuals="True"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Spacing="5"><Border Height="1" Background="#183B70" Margin="0,0,0,7"/><TextBlock Text="D-PAD / LEFT STICK" FontSize="9" Foreground="#7181A2"/><TextBlock Text="A SELECT  •  B BACK" FontSize="9" Foreground="#7181A2"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2.2*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.15*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="2"><TextBlock Text="Home" FontSize="30" FontWeight="Bold"/><TextBlock Text="All your entertainment in one place" FontSize="14" Foreground="#9BA8C7"/></StackPanel>
                <Button Grid.Column="1" x:Name="ConnectButton" Content="Connect Stremio" Click="ConnectButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinWidth="165" MinHeight="46" FontSize="15" Background="#172B4D" Foreground="#FFFFFF" BorderBrush="#2458A7" BorderThickness="1" TabIndex="6" UseSystemFocusVisuals="True"/>
            </Grid>
            <Border Grid.Row="1" CornerRadius="18" BorderBrush="#2458A7" BorderThickness="1" Padding="26" Background="#0B1B3B">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="11" MaxWidth="600">
                        <TextBlock Text="YOUR NEXT FAVOURITE" Foreground="#39D6C5" FontSize="12" FontWeight="Bold" CharacterSpacing="170"/>
                        <TextBlock Text="A new horizon." FontSize="38" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="Explore a world beyond your own." FontSize="16" Foreground="#B7C2DC" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button Content="▶  Discover titles" Click="DiscoverButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinWidth="165" MinHeight="48" FontSize="15" Background="#174BFF" Foreground="#FFFFFF" TabIndex="7" UseSystemFocusVisuals="True"/>
                            <Button Content="+  Add to Library" Click="LibraryButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinWidth="155" MinHeight="48" FontSize="15" Background="#14294D" Foreground="#FFFFFF" BorderBrush="#2458A7" BorderThickness="1" TabIndex="8" UseSystemFocusVisuals="True"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="15,0,0,0">
                        <Border CornerRadius="16" Background="#101F49" BorderBrush="#283F91" BorderThickness="1"/>
                        <Ellipse Width="170" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#182D76" Opacity="0.7"/>
                        <Ellipse Width="115" Height="115" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#1D5BC5" Opacity="0.55"/>
                        <TextBlock Text="▶" FontSize="76" Foreground="#39D6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="YOUR WATCHLIST" FontSize="12" FontWeight="Bold" CharacterSpacing="100" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Continue Watching" FontSize="22" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="Browse all  ›" FontSize="13" Foreground="#39D6C5" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="DiscoverButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" Background="#101F3A" BorderBrush="#2458A7" BorderThickness="1" Padding="0" TabIndex="9" UseSystemFocusVisuals="True">
                    <StackPanel Spacing="0"><Border Height="92" Background="#163D76"><TextBlock Text="◈" FontSize="48" Foreground="#69D8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Padding="10" Spacing="4"><TextBlock Text="Discover something" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Explore movies and series" FontSize="11" Foreground="#9BA8C7"/></StackPanel></StackPanel>
                </Button>
                <Button Grid.Column="1" Click="LibraryButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" Background="#101F3A" BorderBrush="#2458A7" BorderThickness="1" Padding="0" TabIndex="10" UseSystemFocusVisuals="True">
                    <StackPanel Spacing="0"><Border Height="92" Background="#25245C"><TextBlock Text="✦" FontSize="48" Foreground="#B7A1FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Padding="10" Spacing="4"><TextBlock Text="Your library" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Saved titles and watchlist" FontSize="11" Foreground="#9BA8C7" TextWrapping="Wrap"/></StackPanel></StackPanel>
                </Button>
                <Button Grid.Column="2" Click="AddonsButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" Background="#101F3A" BorderBrush="#2458A7" BorderThickness="1" Padding="0" TabIndex="11" UseSystemFocusVisuals="True">
                    <StackPanel Spacing="0"><Border Height="92" Background="#153F50"><TextBlock Text="▦" FontSize="48" Foreground="#39D6C5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Padding="10" Spacing="4"><TextBlock Text="Add-ons" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Catalog sources" FontSize="11" Foreground="#9BA8C7"/></StackPanel></StackPanel>
                </Button>
                <Button Grid.Column="3" Click="SearchButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" Background="#101F3A" BorderBrush="#2458A7" BorderThickness="1" Padding="0" TabIndex="12" UseSystemFocusVisuals="True">
                    <StackPanel Spacing="0"><Border Height="92" Background="#3B1D65"><TextBlock Text="⌕" FontSize="48" Foreground="#D57BFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Padding="10" Spacing="4"><TextBlock Text="Search titles" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Find your next favourite" FontSize="11" Foreground="#9BA8C7" TextWrapping="Wrap"/></StackPanel></StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready. Use your controller to explore." FontSize="12" Foreground="#9BA8C7" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="XBOX ONE  •  CONTROLLER READY" FontSize="10" Foreground="#657493" VerticalAlignment="Center"/></Grid>
        </Grid>
    </Grid>
</Page>