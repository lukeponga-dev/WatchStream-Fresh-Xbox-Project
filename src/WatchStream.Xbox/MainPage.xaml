<Page
    x:Class="WatchStream.Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#080B12"
    Foreground="#F4F6FB"
    Loaded="Page_Loaded">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#9BEA38"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#151A24"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA5B5"/>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#111722"/>
            <Setter Property="Foreground" Value="#D9DFE9"/>
            <Setter Property="BorderBrush" Value="#111722"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
        </Style>
    </Page.Resources>

    <Grid XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Persistent controller-friendly navigation rail -->
        <Border Grid.Column="0" Background="#0D1119" BorderBrush="#202734" BorderThickness="0,0,1,0" Padding="18,24,18,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="W" FontSize="27" FontWeight="Bold" Foreground="#11170B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="WATCHSTREAM" FontSize="15" FontWeight="Bold" CharacterSpacing="35"/>
                        <TextBlock Text="ENTERTAINMENT HUB" FontSize="9" Foreground="#9BA5B5" CharacterSpacing="70"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock Text="YOUR SPACE" FontSize="10" FontWeight="Bold" Foreground="#778293" CharacterSpacing="140" Margin="12,0,0,6"/>
                    <Button x:Name="HomeNavButton" Content="⌂    Home" Style="{StaticResource RailButtonStyle}" Background="#27351C" Foreground="#B8F875" BorderBrush="#3E5429" Click="HomeNavButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" TabIndex="0"/>
                    <Button x:Name="DiscoverButton" Content="✦    Discover" Style="{StaticResource RailButtonStyle}" Click="DiscoverButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" TabIndex="1"/>
                    <Button x:Name="LibraryButton" Content="▤    My Library" Style="{StaticResource RailButtonStyle}" Click="LibraryButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" TabIndex="2"/>
                    <Button x:Name="SeriesNavButton" Content="▣    Series" Style="{StaticResource RailButtonStyle}" Click="SeriesButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" TabIndex="3"/>
                    <Button x:Name="SearchButton" Content="⌕    Search" Style="{StaticResource RailButtonStyle}" Click="SearchButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" TabIndex="4"/>
                    <Border Height="1" Background="#242B37" Margin="10,12,10,8"/>
                    <Button x:Name="AddonsButton" Content="▦    Add-ons" Style="{StaticResource RailButtonStyle}" Click="AddonsButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" TabIndex="5"/>
                    <Button x:Name="SettingsButton" Content="⚙    Settings" Style="{StaticResource RailButtonStyle}" Click="SettingsButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" TabIndex="6"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="8">
                    <Border Background="#151B25" BorderBrush="#2B3443" BorderThickness="1" CornerRadius="12" Padding="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="STREMIO ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#9BA5B5" CharacterSpacing="75"/>
                            <TextBlock Text="Sync your streaming setup" FontSize="12" Foreground="#DCE2EC" TextWrapping="Wrap"/>
                            <Button x:Name="ConnectButton" Content="Connect account  ›" Click="ConnectButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="38" HorizontalContentAlignment="Left" Padding="2,0" Background="Transparent" Foreground="#B8F875" BorderThickness="0" FontSize="13" TabIndex="7" UseSystemFocusVisuals="True"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="A  SELECT     B  BACK" FontSize="10" Foreground="#707B8C" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main dashboard -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ZoomMode="Disabled">
            <Grid Margin="34,26,34,26" RowSpacing="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="GOOD EVENING" FontSize="11" FontWeight="Bold" Foreground="#B8F875" CharacterSpacing="170"/>
                        <TextBlock Text="What are we watching?" FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Your movies, series and add-ons — all in one place." FontSize="15" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#151A24" BorderBrush="#2B3443" BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="#9BEA38"/>
                            <TextBlock Text="XBOX READY" FontSize="11" FontWeight="Bold" Foreground="#DCE2EC" VerticalAlignment="Center" CharacterSpacing="55"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" CornerRadius="20" Background="#18231A" BorderBrush="#35452E" BorderThickness="1" Padding="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="13" MaxWidth="560">
                            <Border Background="#2C4020" CornerRadius="6" Padding="9,5" HorizontalAlignment="Left">
                                <TextBlock Text="MADE FOR YOUR NEXT MARATHON" FontSize="10" FontWeight="Bold" Foreground="#C6F69A" CharacterSpacing="80"/>
                            </Border>
                            <TextBlock Text="Your next favourite\nstarts here." FontSize="38" FontWeight="Bold" TextWrapping="Wrap" LineHeight="43"/>
                            <TextBlock Text="Explore something new, pick up where you left off, or find a series worth staying in for." FontSize="15" Foreground="#C0CBB8" TextWrapping="Wrap" MaxWidth="490"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                <Button Content="✦   Explore titles" Click="DiscoverButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinWidth="174" MinHeight="50" Padding="18,0" FontSize="15" FontWeight="SemiBold" Background="#9BEA38" Foreground="#12180D" BorderBrush="#9BEA38" TabIndex="8" UseSystemFocusVisuals="True"/>
                                <Button Content="▤   Open library" Click="LibraryButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinWidth="155" MinHeight="50" Padding="16,0" FontSize="15" Background="#202B22" Foreground="#F4F6FB" BorderBrush="#465540" BorderThickness="1" TabIndex="9" UseSystemFocusVisuals="True"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="18,0,0,0">
                            <Ellipse Width="240" Height="240" Fill="#2A3C25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="186" Height="186" Fill="#354D2C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="132" Height="132" Fill="#9BEA38" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.95"/>
                            <TextBlock Text="▶" FontSize="66" FontWeight="Bold" Foreground="#17200F" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0,0,4"/>
                            <Border Background="#111A12" CornerRadius="8" Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <TextBlock Text="YOUR WATCHLIST, REIMAGINED" FontSize="10" FontWeight="Bold" Foreground="#C6F69A" CharacterSpacing="65"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Continue watching" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Jump back into the stories you love." FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse all  ›" Click="DiscoverButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" VerticalAlignment="Center" MinHeight="42" Padding="14,0" Background="#151A24" Foreground="#B8F875" BorderBrush="#303949" BorderThickness="1" FontSize="13" TabIndex="10" UseSystemFocusVisuals="True"/>
                </Grid>

                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled">
                    <ItemsControl x:Name="HomeMediaItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="HomeMediaCard_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" Background="#151A24" BorderBrush="#2B3443" BorderThickness="1" Padding="0" Width="184" MinHeight="232" UseSystemFocusVisuals="True">
                                    <StackPanel Spacing="0">
                                        <Grid Height="150" Background="#202A37">
                                            <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                                            <Border Background="#99080B12" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="5" Padding="7,4" Margin="9">
                                                <TextBlock Text="WATCHSTREAM PICK" FontSize="8" FontWeight="Bold" Foreground="#DDF7C8" CharacterSpacing="30"/>
                                            </Border>
                                            <Border Width="38" Height="38" CornerRadius="19" Background="#9BEA38" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                                                <TextBlock Text="▶" FontSize="16" FontWeight="Bold" Foreground="#17200F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <Border Padding="12,11">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Height="38"/>
                                                <TextBlock Text="{Binding Year}" FontSize="12" Foreground="#9BA5B5"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready. Use your controller to explore." FontSize="12" Foreground="#9BA5B5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="WATCHSTREAM  •  XBOX ONE / SERIES X|S" FontSize="10" Foreground="#707B8C" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
