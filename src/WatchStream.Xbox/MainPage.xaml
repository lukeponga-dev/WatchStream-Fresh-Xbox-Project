<Page
    x:Class="WatchStream.Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B1020"
    Foreground="#F5F7FF"
    Loaded="Page_Loaded">

    <Grid Padding="56,36,56,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="12" Background="#39D6C5">
                    <TextBlock Text="W" FontSize="28" FontWeight="Bold" Foreground="#07111D"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="WATCHSTREAM" FontSize="25" FontWeight="Bold" CharacterSpacing="120"/>
                    <TextBlock Text="YOUR MEDIA, YOUR WAY" FontSize="11" Foreground="#9BA8C7" CharacterSpacing="160"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="ConnectionLabel" Text="NOT CONNECTED" FontSize="13"
                           Foreground="#A9B5D1" VerticalAlignment="Center"/>
                <Border Width="10" Height="10" CornerRadius="5" Background="#F6B94A"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Hero panel -->
        <Border Grid.Row="2" CornerRadius="22" Padding="34"
                Background="#17213A" BorderBrush="#2A3858" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="14" MaxWidth="760">
                    <TextBlock Text="YOUR NEXT FAVOURITE" Foreground="#39D6C5"
                               FontSize="13" FontWeight="Bold" CharacterSpacing="180"/>
                    <TextBlock Text="Find something\nto watch." FontSize="48" FontWeight="Bold"
                               TextWrapping="Wrap" LineHeight="56"/>
                    <TextBlock Text="A controller-friendly home for your movie and series library."
                               FontSize="19" Foreground="#B7C2DC" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
                        <Button x:Name="BrowseButton" Content="Browse library" Click="BrowseButton_Click"
                                IsTabStop="True" TabIndex="0" MinWidth="190" MinHeight="58"
                                FontSize="18" FontWeight="SemiBold"
                                Background="#39D6C5" Foreground="#07111D"
                                UseSystemFocusVisuals="True"/>
                        <Button x:Name="ConnectButton" Content="Connect Stremio" Click="ConnectButton_Click"
                                IsTabStop="True" TabIndex="1" MinWidth="190" MinHeight="58"
                                FontSize="18" FontWeight="SemiBold"
                                Background="#263452" Foreground="#F5F7FF"
                                UseSystemFocusVisuals="True"/>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Margin="24,0,0,0">
                    <Border CornerRadius="18" Background="#10182B" BorderBrush="#344564" BorderThickness="1"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <TextBlock Text="▶" FontSize="64" Foreground="#39D6C5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="YOUR WATCHLIST" FontSize="15" FontWeight="Bold"
                                   CharacterSpacing="120" HorizontalAlignment="Center"/>
                        <TextBlock Text="Movies • Series • Discover" FontSize="14"
                                   Foreground="#9BA8C7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Section heading -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Explore WatchStream" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="Choose a section using your controller" FontSize="14" Foreground="#9BA8C7"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="D-PAD / LEFT STICK  •  A SELECT  •  B BACK"
                       FontSize="12" Foreground="#9BA8C7" VerticalAlignment="Center"/>
        </Grid>

        <!-- Main navigation cards -->
        <Grid Grid.Row="6" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="LibraryButton_Click" TabIndex="2" IsTabStop="True"
                    UseSystemFocusVisuals="True" Background="#17213A" Foreground="#F5F7FF"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Padding="0" MinHeight="190">
                <StackPanel Margin="22" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="▤" FontSize="38" Foreground="#39D6C5"/>
                    <TextBlock Text="My Library" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Continue with your saved titles." FontSize="14"
                               Foreground="#B7C2DC" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Click="DiscoverButton_Click" TabIndex="3" IsTabStop="True"
                    UseSystemFocusVisuals="True" Background="#17213A" Foreground="#F5F7FF"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Padding="0" MinHeight="190">
                <StackPanel Margin="22" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="38" Foreground="#F6B94A"/>
                    <TextBlock Text="Discover" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Find something new to watch." FontSize="14"
                               Foreground="#B7C2DC" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Click="SeriesButton_Click" TabIndex="4" IsTabStop="True"
                    UseSystemFocusVisuals="True" Background="#17213A" Foreground="#F5F7FF"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Padding="0" MinHeight="190">
                <StackPanel Margin="22" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="▣" FontSize="38" Foreground="#A995FF"/>
                    <TextBlock Text="Series" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Browse TV and episodic content." FontSize="14"
                               Foreground="#B7C2DC" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Click="SettingsButton_Click" TabIndex="5" IsTabStop="True"
                    UseSystemFocusVisuals="True" Background="#17213A" Foreground="#F5F7FF"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Padding="0" MinHeight="190">
                <StackPanel Margin="22" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="38" Foreground="#FF8FA3"/>
                    <TextBlock Text="Settings" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Account, playback and app options." FontSize="14"
                               Foreground="#B7C2DC" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status / future integration note -->
        <Grid Grid.Row="7" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready. Select a section to get started."
                       FontSize="13" Foreground="#A9B5D1" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Column="1" Text="WATCHSTREAM  •  XBOX ONE" FontSize="12"
                       Foreground="#657493" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
