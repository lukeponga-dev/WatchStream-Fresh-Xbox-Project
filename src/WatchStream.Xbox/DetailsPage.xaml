<Page
    x:Class="WatchStream.Xbox.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WatchStream.Xbox"
    Background="#050B1B"
    Foreground="#F4F6FB"
    Loaded="Page_Loaded">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#E50914" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA5B5" />

        <Style x:Key="StreamSourceButtonStyle" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Background" Value="#17213A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#2A3858" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="MainBorder" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                                <Grid x:Name="MainBorder" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <ContentPresenter />
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid ColumnSpacing="0" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NavigationSidebar Grid.Column="0" CurrentSection=""/>
        <Grid Grid.Column="1" Padding="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Poster & Basic Info -->
        <StackPanel Grid.Column="0" Spacing="24">
            <Border CornerRadius="12">
                <Image x:Name="PosterImage" Stretch="UniformToFill" Width="400" Height="600"/>
            </Border>
            <TextBlock x:Name="TitleText" Text="Movie Title" FontSize="32" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="YearText" Text="2024" FontSize="18" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <!-- Right: Details & Streams -->
        <ScrollViewer Grid.Column="1" Margin="60,0,0,0" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="32">
                <TextBlock x:Name="DescriptionText" Text="Description loading..." FontSize="20" Foreground="#D9DFE9" TextWrapping="Wrap" LineHeight="30"/>
                
                <StackPanel Spacing="16">
                    <TextBlock Text="AVAILABLE STREAMS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" CharacterSpacing="150"/>
                    <TextBlock x:Name="StreamsStatusText" Text="Streams will appear here." FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <Button x:Name="FindStreamsButton" Content="Find streams again" Click="FindStreamsButton_Click" MinWidth="190" MinHeight="48" Background="#5268FF" Foreground="White" HorizontalAlignment="Left"/>
                    <ItemsControl x:Name="StreamsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource StreamSourceButtonStyle}" Click="PlayButton_Click" GotFocus="StreamButton_GotFocus" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Resolution}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</Page>
