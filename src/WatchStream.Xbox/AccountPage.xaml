<Page
    x:Class="WatchStream.Xbox.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#05080F"
    Foreground="#F4F6FB">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#9BEA38" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA5B5" />
    </Page.Resources>

    <Grid Padding="60">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Spacing="32">
            
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="Connect Stremio" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Pair your Xbox with your account" FontSize="18" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Background="#121824" CornerRadius="24" Padding="40" BorderBrush="#20FFFFFF" BorderThickness="1">
                <StackPanel Spacing="24" HorizontalAlignment="Center">
                    <TextBlock Text="Please visit the website below on your phone or computer:" 
                               FontSize="16" Foreground="#D9DFE9" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    
                    <TextBlock Text="stremio.tv/activate" FontSize="24" FontWeight="SemiBold" 
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" CharacterSpacing="100"/>
                    
                    <TextBlock Text="And enter the pairing code:" FontSize="16" Foreground="#D9DFE9" HorizontalAlignment="Center"/>
                    
                    <Border Background="#05080F" Padding="20" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="PairingCodeText" Text="LOADING..." FontSize="48" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center" CharacterSpacing="200"/>
                    </Border>
                </StackPanel>
            </Border>

            <Button x:Name="BackButton" Content="Back to Home" Click="BackButton_Click" 
                    HorizontalAlignment="Center" Padding="24,12" CornerRadius="8" 
                    Background="#22FFFFFF" Foreground="White" FontSize="16"/>
        </StackPanel>
    </Grid>
</Page>
