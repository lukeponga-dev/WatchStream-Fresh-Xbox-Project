<Page
    x:Class="WatchStream.Xbox.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B1020" Foreground="#F5F7FF" Loaded="Page_Loaded">
    <Grid Padding="56,36,56,32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="12" Background="#39D6C5">
                    <TextBlock Text="W" FontSize="28" FontWeight="Bold" Foreground="#07111D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="WATCHSTREAM" FontSize="25" FontWeight="Bold" CharacterSpacing="120"/>
                    <TextBlock Text="STREMIO ACCOUNT" FontSize="11" Foreground="#9BA8C7" CharacterSpacing="160"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Home" Click="HomeButton_Click" MinWidth="130" MinHeight="52"
                    FontSize="17" Background="#263452" Foreground="#F5F7FF" TabIndex="0" UseSystemFocusVisuals="True"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,30,0,24">
            <Border Background="#17213A" BorderBrush="#2A3858" BorderThickness="1" CornerRadius="22" Padding="36"
                    MaxWidth="820" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <TextBlock Text="Connect your Stremio account" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="Sign in with your Stremio email and password. Your password is sent over HTTPS for sign-in only and is not saved by WatchStream."
                               FontSize="17" Foreground="#B7C2DC" TextWrapping="Wrap"/>
                    <StackPanel x:Name="SignedOutPanel" Spacing="12">
                        <TextBlock Text="Email address" FontSize="16" FontWeight="SemiBold"/>
                        <TextBox x:Name="EmailBox" PlaceholderText="you@example.com" MinHeight="54" FontSize="18" TabIndex="1" UseSystemFocusVisuals="True"/>
                        <TextBlock Text="Password" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <PasswordBox x:Name="PasswordBox" PlaceholderText="Stremio password" MinHeight="54" FontSize="18" TabIndex="2" UseSystemFocusVisuals="True"/>
                        <Button x:Name="SignInButton" Content="Sign in securely" Click="SignInButton_Click" MinHeight="58" MinWidth="220"
                                FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" Background="#39D6C5" Foreground="#07111D" TabIndex="3" UseSystemFocusVisuals="True"/>
                    </StackPanel>
                    <StackPanel x:Name="SignedInPanel" Visibility="Collapsed" Spacing="14">
                        <TextBlock Text="You're connected" FontSize="25" FontWeight="Bold" Foreground="#39D6C5"/>
                        <TextBlock Text="Your session key is stored in the Windows credential vault. Your password was not saved."
                                   FontSize="16" Foreground="#B7C2DC" TextWrapping="Wrap"/>
                        <Button Content="Sign out" Click="SignOutButton_Click" MinHeight="56" MinWidth="180" FontSize="18"
                                Background="#263452" Foreground="#F5F7FF" TabIndex="4" UseSystemFocusVisuals="True"/>
                    </StackPanel>
                    <ProgressRing x:Name="BusyRing" IsActive="False" Width="42" Height="42" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Text="Your credentials stay on this device during sign-in." FontSize="15" Foreground="#A9B5D1" TextWrapping="Wrap"/>
                    <TextBlock Text="Email/password sign-in only. QR and device-code login are not implemented." FontSize="13" Foreground="#7F8EAF" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="D-PAD / LEFT STICK  •  A SELECT  •  B BACK" FontSize="12" Foreground="#657493" VerticalAlignment="Center"/>
    </Grid>
</Page>
