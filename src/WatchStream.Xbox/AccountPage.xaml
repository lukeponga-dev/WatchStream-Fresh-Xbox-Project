<Page
    x:Class="WatchStream.Xbox.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B1020" Foreground="#F5F7FF" Loaded="Page_Loaded">
    <Grid Padding="32,18,32,18" XYFocusKeyboardNavigation="Enabled">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10" Background="#39D6C5"><TextBlock Text="W" FontSize="25" FontWeight="Bold" Foreground="#07111D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="WATCHSTREAM" FontSize="22" FontWeight="Bold" CharacterSpacing="100"/><TextBlock Text="STREMIO ACCOUNT" FontSize="10" Foreground="#9BA8C7" CharacterSpacing="140"/></StackPanel>
            </StackPanel>
            <Button x:Name="HomeButton" Grid.Column="1" Content="Home" Click="HomeButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"
                    MinWidth="110" MinHeight="46" FontSize="16" Background="#263452" Foreground="#F5F7FF" TabIndex="0" UseSystemFocusVisuals="True"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ZoomMode="Disabled">
            <Border Background="#17213A" BorderBrush="#2A3858" BorderThickness="1" CornerRadius="18" Padding="22" MaxWidth="820" HorizontalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Connect your Stremio account" FontSize="27" FontWeight="Bold" TextWrapping="Wrap"/>
                    <StackPanel x:Name="QrPanel" Spacing="8">
                        <TextBlock Text="1. Scan the QR code with your phone.  2. Sign in to Stremio and approve the link." FontSize="16" Foreground="#B7C2DC" TextWrapping="Wrap"/>
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="5" HorizontalAlignment="Center"><WebView x:Name="QrWebView" DefaultBackgroundColor="#FFFFFF" Width="154" Height="154"/></Border>
                        <TextBlock Text="Or visit link.stremio.com and enter this code:" FontSize="15" Foreground="#B7C2DC" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LinkCodeText" Text="Loading…" FontSize="30" FontWeight="Bold" CharacterSpacing="180" HorizontalAlignment="Center" Foreground="#39D6C5"/>
                        <TextBlock x:Name="LinkUrlText" Text="https://link.stremio.com/" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="#B7C2DC"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <Button x:Name="RefreshLinkButton" Content="New code" Click="RefreshLinkButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"
                                    MinHeight="48" MinWidth="140" FontSize="16" Background="#39D6C5" Foreground="#07111D" TabIndex="1" UseSystemFocusVisuals="True" XYFocusRight="{x:Bind FacebookLoginButton}"/>
                            <Button x:Name="FacebookLoginButton" Content="Continue with Facebook" Click="FacebookLoginButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"
                                    MinHeight="48" MinWidth="220" FontSize="16" Background="#1877F2" Foreground="#FFFFFF" TabIndex="2" UseSystemFocusVisuals="True" XYFocusLeft="{x:Bind RefreshLinkButton}" XYFocusRight="{x:Bind EmailOptionButton}"/>
                            <Button x:Name="EmailOptionButton" Content="Use email instead" Click="UseEmailButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"
                                    MinHeight="48" MinWidth="180" FontSize="16" Background="#263452" Foreground="#F5F7FF" TabIndex="3" UseSystemFocusVisuals="True" XYFocusLeft="{x:Bind FacebookLoginButton}"/>
                        </StackPanel>
                        <TextBlock Text="Facebook sign-in opens Stremio's official account-link page in your browser. Finish sign-in there to connect this Xbox." FontSize="13" Foreground="#9BA8C7" TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="600"/>
                    </StackPanel>
                    <StackPanel x:Name="SignedOutPanel" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="Email address" FontSize="16" FontWeight="SemiBold"/>
                        <TextBox x:Name="EmailBox" PlaceholderText="you@example.com" MinHeight="50" FontSize="18" TabIndex="3" UseSystemFocusVisuals="True"/>
                        <TextBlock Text="Password" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <PasswordBox x:Name="PasswordBox" PlaceholderText="Stremio password" MinHeight="50" FontSize="18" TabIndex="4" UseSystemFocusVisuals="True"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button x:Name="SignInButton" Content="Sign in securely" Click="SignInButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"
                                    MinHeight="50" MinWidth="200" FontSize="17" FontWeight="SemiBold" Background="#39D6C5" Foreground="#07111D" TabIndex="5" UseSystemFocusVisuals="True" XYFocusRight="{x:Bind BackToQrButton}"/>
                            <Button x:Name="BackToQrButton" Content="Back to QR code" Click="UseQrButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"
                                    MinHeight="50" MinWidth="170" FontSize="16" Background="#263452" Foreground="#F5F7FF" TabIndex="6" UseSystemFocusVisuals="True" XYFocusLeft="{x:Bind SignInButton}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="SignedInPanel" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="You're connected" FontSize="24" FontWeight="Bold" Foreground="#39D6C5"/>
                        <TextBlock Text="Your session key is stored securely. Your password was not saved." FontSize="16" Foreground="#B7C2DC" TextWrapping="Wrap"/>
                        <Button x:Name="SignOutButton" Content="Sign out" Click="SignOutButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus"
                                MinHeight="50" MinWidth="160" FontSize="17" Background="#263452" Foreground="#F5F7FF" TabIndex="7" UseSystemFocusVisuals="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="BusyRing" IsActive="False" Width="24" Height="24" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" Text="Your password is never requested by the QR-link flow." FontSize="14" Foreground="#A9B5D1" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Text="D-PAD / LEFT STICK  •  A SELECT  •  B BACK" FontSize="11" Foreground="#657493" VerticalAlignment="Center"/>
    </Grid>
</Page>