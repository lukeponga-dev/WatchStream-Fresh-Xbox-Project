<Page
    x:Class="WatchStream.Xbox.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WatchStream.Xbox"
    Background="#050B1B" Foreground="#F5F7FF" Loaded="Page_Loaded">
    <Grid ColumnSpacing="0" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NavigationSidebar Grid.Column="0" CurrentSection="Settings"/>
        <Grid Grid.Column="1" Margin="28,24,28,24" RowSpacing="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="5"><TextBlock Text="Settings" FontSize="36" FontWeight="Bold"/><TextBlock Text="Manage WatchStream preferences and connections." FontSize="16" Foreground="#A9B5D1" TextWrapping="Wrap"/></StackPanel>
            <Border Grid.Row="1" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel Spacing="8"><TextBlock Text="Account" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Connect or manage the Stremio account used by WatchStream." FontSize="15" Foreground="#B7C2DC" TextWrapping="Wrap"/><Button Content="Sign in" Click="ConnectButton_Click" MinWidth="180" MinHeight="48" HorizontalAlignment="Left" Background="#5268FF" Foreground="White" FontSize="16" TabIndex="8"/></StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel Spacing="10"><TextBlock Text="Stremio Streaming Server" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Connect to Stremio Server running on your PC or another device on the same network. Xbox does not host the server itself." FontSize="15" Foreground="#B7C2DC" TextWrapping="Wrap"/><TextBlock Text="Server URL" FontSize="14" Foreground="#B7C2DC"/><TextBox x:Name="ServerUrlBox" PlaceholderText="http://192.168.1.20:11470" MinHeight="48" FontSize="16" TabIndex="9"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Test &amp; Save Server" Click="TestServerButton_Click" MinWidth="190" MinHeight="48" Background="#5268FF" Foreground="White" FontSize="15" TabIndex="10"/><Button Content="Manage add-ons" Click="AddonsButton_Click" MinWidth="160" MinHeight="48" Background="#14294D" Foreground="White" FontSize="15" TabIndex="11"/></StackPanel><TextBlock x:Name="ServerStatusText" Text="Server not checked yet." FontSize="13" Foreground="#9BA8C7" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <TextBlock Grid.Row="3" x:Name="StatusText" Text="Settings page ready." FontSize="13" Foreground="#9BA8C7" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Page>
