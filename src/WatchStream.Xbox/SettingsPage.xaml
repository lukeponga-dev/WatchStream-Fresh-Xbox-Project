<Page
    x:Class="WatchStream.Xbox.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#050B1B" Foreground="#F5F7FF" Loaded="Page_Loaded">
    <Grid ColumnSpacing="0" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#07142A" BorderBrush="#183B70" BorderThickness="1" Padding="18,20">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,18">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#39D6C5"><TextBlock Text="▶" FontSize="20" FontWeight="Bold" Foreground="#07111D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="WATCHSTREAM" FontSize="15" FontWeight="Bold"/><TextBlock Text="SETTINGS" FontSize="9" Foreground="#9BA8C7"/></StackPanel>
                </StackPanel>
                <Button Content="⌂   Home" Click="HomeButton_Click" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" Background="#101F3A" Foreground="White" TabIndex="0"/>
                <Button Content="✦   Discover" Click="DiscoverButton_Click" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" Background="#101F3A" Foreground="White" TabIndex="1"/>
                <Button Content="▤   Library" Click="LibraryButton_Click" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" Background="#101F3A" Foreground="White" TabIndex="2"/>
                <Button Content="▣   Series" Click="SeriesButton_Click" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" Background="#101F3A" Foreground="White" TabIndex="3"/>
                <Button Content="▦   Add-ons" Click="AddonsButton_Click" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" Background="#101F3A" Foreground="White" TabIndex="4"/>
                <Button Content="⌕   Search" Click="SearchButton_Click" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" Background="#101F3A" Foreground="White" TabIndex="5"/>
                <Button Content="↔   Connect Stremio" Click="ConnectButton_Click" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" Background="#101F3A" Foreground="White" TabIndex="6"/>
                <Button x:Name="SettingsNavButton" Content="⚙   Settings" Click="SettingsButton_Click" MinHeight="43" HorizontalContentAlignment="Left" Padding="12,0" Background="#5268FF" Foreground="White" TabIndex="7"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,28,24" RowSpacing="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="5"><TextBlock Text="Settings" FontSize="36" FontWeight="Bold"/><TextBlock Text="Manage WatchStream preferences and connections." FontSize="16" Foreground="#A9B5D1" TextWrapping="Wrap"/></StackPanel>
            <Border Grid.Row="1" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel Spacing="8"><TextBlock Text="Account" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Connect or manage the Stremio account used by WatchStream." FontSize="15" Foreground="#B7C2DC" TextWrapping="Wrap"/><Button Content="Connect Stremio" Click="ConnectButton_Click" MinWidth="180" MinHeight="48" HorizontalAlignment="Left" Background="#5268FF" Foreground="White" FontSize="16" TabIndex="8"/></StackPanel>
            </Border>
            <Border Grid.Row="2" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel Spacing="10"><TextBlock Text="Playback and compatibility" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Playback depends on the stream format and codecs supported by Xbox. Add-on management is available from the Add-ons section." FontSize="15" Foreground="#B7C2DC" TextWrapping="Wrap"/><Button Content="Manage add-ons" Click="AddonsButton_Click" MinWidth="180" MinHeight="48" HorizontalAlignment="Left" Background="#14294D" Foreground="White" FontSize="16" TabIndex="9"/></StackPanel>
            </Border>
            <TextBlock Grid.Row="3" x:Name="StatusText" Text="Settings page ready." FontSize="13" Foreground="#9BA8C7" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Page>