<Page
    x:Class="WatchStream.Xbox.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black"
    Loaded="Page_Loaded">

    <Grid>
        <!-- Fullscreen Media Player -->
        <MediaPlayerElement x:Name="PlayerElement" 
                            AreTransportControlsEnabled="True" 
                            Stretch="UniformToFill" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"/>

        <!-- Explicit exit control complements Xbox B/Back and returns to the previous logical page. -->
        <Button Content="‹  BACK" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="32,28,0,0" Padding="20,12" MinWidth="112" MinHeight="48"
                Background="#CC121824" Foreground="White" BorderThickness="0"
                Click="PlayerBack_Click" />

        <!-- Overlay for errors or loading -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#AA000000">
            <TextBlock Text="Loading Stream..." Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
        </Grid>
    </Grid>
</Page>
