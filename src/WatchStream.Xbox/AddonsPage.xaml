<Page
    x:Class="WatchStream.Xbox.AddonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WatchStream.Xbox"
    Background="#050B1B" Foreground="#F5F7FF" Loaded="Page_Loaded">
    <Grid ColumnSpacing="0" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NavigationSidebar Grid.Column="0" CurrentSection="Add-ons"/>
        <Grid Grid.Column="1" Margin="26,22,26,20" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="5"><TextBlock Text="Add-ons" FontSize="36" FontWeight="Bold"/><TextBlock Text="Install compatible Stremio add-ons and manage their availability in WatchStream." FontSize="16" Foreground="#A9B5D1" TextWrapping="Wrap"/></StackPanel>
            <Border Grid.Row="1" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6"><TextBlock Text="ADD-ON MANIFEST URL" FontSize="11" FontWeight="Bold" Foreground="#E50914" CharacterSpacing="100"/><TextBox x:Name="ManifestUrlBox" PlaceholderText="https://example-addon.com/manifest.json" MinHeight="48" FontSize="16" TabIndex="7"/></StackPanel>
                    <Button Grid.Column="1" x:Name="InstallButton" Content="＋  Install add-on" Click="InstallButton_Click" MinWidth="170" MinHeight="48" Margin="0,0,8,0" VerticalAlignment="Bottom" Background="#5268FF" Foreground="White" FontSize="16" TabIndex="8"/>
                    <Button Grid.Column="2" x:Name="SyncAccountButton" Content="↻  Sync Stremio" Click="SyncAccountButton_Click" MinWidth="160" MinHeight="48" VerticalAlignment="Bottom" Background="#142545" Foreground="White" FontSize="16" TabIndex="9"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="INSTALLED ADD-ONS" FontSize="12" FontWeight="Bold" Foreground="#E50914" CharacterSpacing="130" Margin="0,0,0,14"/>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyAddonsText" Text="No add-ons installed yet. Enter a manifest URL above to add one." FontSize="18" Foreground="#A9B5D1" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="600"/>
                        <ListView x:Name="AddonsList" Background="Transparent" BorderThickness="0" SelectionMode="None" IsItemClickEnabled="False" TabIndex="9">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#101F3A" BorderBrush="#183B70" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#A9B5D1" TextWrapping="Wrap" MaxLines="2"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Version}" FontSize="12" Foreground="#9BA8C7"/><TextBlock Text="{Binding ManifestUrl}" FontSize="11" Foreground="#7181A2" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                <TextBlock Text="{Binding Capabilities}" FontSize="12" Foreground="#75E5D3" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Remove" Tag="{Binding ManifestUrl}" Click="RemoveButton_Click" VerticalAlignment="Center" MinWidth="100" MinHeight="44" Background="#422033" Foreground="#FFD8E1" TabIndex="10"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Grid.Row="3" x:Name="StatusText" Text="Add-ons are stored on this device." FontSize="13" Foreground="#9BA8C7" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Page>