<Page
    x:Class="WatchStream.Xbox.AddonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WatchStream.Xbox"
    Background="#050B1B" Foreground="#F5F7FF" Loaded="Page_Loaded">
    <Grid ColumnSpacing="0" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NavigationSidebar Grid.Column="0" CurrentSection="Add-ons"/>
        <Grid Grid.Column="1" Margin="26,22,26,20" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="5">
                <TextBlock Text="Add-ons" FontSize="36" FontWeight="Bold"/>
                <TextBlock Text="Discover community add-ons, install compatible manifests, and sync your Stremio account." FontSize="16" Foreground="#A9B5D1" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="ADD-ON MANIFEST URL" FontSize="11" FontWeight="Bold" Foreground="#E50914" CharacterSpacing="100"/>
                        <TextBox x:Name="ManifestUrlBox" PlaceholderText="https://example-addon.com/manifest.json" MinHeight="46" FontSize="15" TabIndex="7"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="InstallButton" Content="＋  Install URL" Click="InstallButton_Click" MinWidth="140" MinHeight="46" Margin="0,0,4,0" VerticalAlignment="Bottom" Background="#5268FF" Foreground="White" FontSize="15" TabIndex="8"/>
                    <Button Grid.Column="2" x:Name="SyncAccountButton" Content="↻  Sync Stremio" Click="SyncAccountButton_Click" MinWidth="145" MinHeight="46" VerticalAlignment="Bottom" Background="#142545" Foreground="White" FontSize="15" TabIndex="9"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="COMMUNITY DIRECTORY" FontSize="12" FontWeight="Bold" Foreground="#E50914" CharacterSpacing="100"/>
                            <TextBlock Text="Popular and searchable add-ons" FontSize="12" Foreground="#A9B5D1"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="DirectorySearchBox" PlaceholderText="Search add-ons…" MinHeight="42" FontSize="15" TabIndex="10" KeyDown="DirectorySearchBox_KeyDown"/>
                        <Button Grid.Column="2" x:Name="DirectorySearchButton" Content="Search" Click="DirectorySearchButton_Click" MinWidth="100" MinHeight="42" Background="#142545" Foreground="White" TabIndex="11"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="DirectoryEmptyText" Text="Loading community add-ons…" FontSize="17" Foreground="#A9B5D1" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="600"/>
                        <ListView x:Name="DirectoryList" Background="Transparent" BorderThickness="0" SelectionMode="None" IsItemClickEnabled="False" TabIndex="12">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#101F3A" BorderBrush="#183B70" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#A9B5D1" TextWrapping="Wrap" MaxLines="2"/>
                                                <TextBlock Text="{Binding Categories}" FontSize="11" Foreground="#75E5D3" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding PopularityLabel}" FontSize="11" Foreground="#9BA8C7"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="＋ Add" Tag="{Binding ManifestUrl}" Click="DirectoryInstallButton_Click" VerticalAlignment="Center" MinWidth="95" MinHeight="44" Background="#5268FF" Foreground="White" TabIndex="13"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="INSTALLED ON THIS DEVICE" FontSize="12" FontWeight="Bold" Foreground="#E50914" CharacterSpacing="100" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyAddonsText" Text="No add-ons installed yet. Select Add on a directory item or enter a manifest URL above." FontSize="15" Foreground="#A9B5D1" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="600"/>
                        <ListView x:Name="AddonsList" Background="Transparent" BorderThickness="0" SelectionMode="None" IsItemClickEnabled="False" TabIndex="14">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#101F3A" BorderBrush="#183B70" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#A9B5D1" TextWrapping="Wrap" MaxLines="1"/>
                                                <TextBlock Text="{Binding SyncStatus}" FontSize="11" Foreground="#75E5D3"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Remove" Tag="{Binding ManifestUrl}" Click="RemoveButton_Click" VerticalAlignment="Center" MinWidth="90" MinHeight="40" Background="#422033" Foreground="#FFD8E1" TabIndex="15"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4" Spacing="4">
                <TextBlock x:Name="StatusText" Text="Directory data provided by Stremio Addons." FontSize="12" Foreground="#9BA8C7" TextWrapping="Wrap"/>
                <TextBlock FontSize="12" Foreground="#9BA8C7"><Run Text="Community directory: "/><Hyperlink NavigateUri="https://stremio-addons.net/" Click="DirectoryAttribution_Click">Stremio Addons</Hyperlink><Run Text=" · Catalog data is community-maintained; review add-ons before installing."/></TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
