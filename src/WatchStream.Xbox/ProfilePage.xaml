<Page
    x:Class="WatchStream.Xbox.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WatchStream.Xbox"
    Background="#050B1B" Foreground="#F4F6FB" Loaded="ProfilePage_Loaded">
    <Grid ColumnSpacing="0" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NavigationSidebar Grid.Column="0" CurrentSection="Profile"/>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="42,36" Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Text="ACCOUNT PROFILE" FontSize="11" FontWeight="Bold" Foreground="#39D6C5" CharacterSpacing="160"/>
                <TextBlock Text="Your Stremio account" FontSize="36" FontWeight="Bold"/>
                <TextBlock Text="Your connected identity and account session for WatchStream." FontSize="16" Foreground="#A9B5D1" TextWrapping="Wrap"/>
                <Border Background="#0B1830" BorderBrush="#263D62" BorderThickness="1" CornerRadius="18" Padding="28">
                    <Grid ColumnSpacing="22">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="88" Height="88" CornerRadius="44" Background="#E50914" VerticalAlignment="Top">
                            <TextBlock x:Name="ProfileInitials" Text="S" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="DISPLAY NAME" FontSize="10" Foreground="#7186AA" CharacterSpacing="120"/>
                            <TextBlock x:Name="DisplayNameText" Text="Loading profile…" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="EMAIL" FontSize="10" Foreground="#7186AA" CharacterSpacing="120" Margin="0,10,0,0"/>
                            <TextBlock x:Name="EmailText" Text="Checking your Stremio session" FontSize="16" Foreground="#C7D2E8" TextWrapping="Wrap"/>
                            <Border Background="#12352F" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="#39D6C5" VerticalAlignment="Center"/><TextBlock x:Name="ConnectionStatusText" Text="Connected" FontSize="12" Foreground="#8CF0DF"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="StatusText" Text="Profile details are loaded from your signed-in Stremio account." FontSize="13" Foreground="#9BA8C7" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="SignOutButton" Content="Sign out" Click="SignOutButton_Click" MinWidth="160" MinHeight="50" Background="#E50914" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <Button Content="Back to Home" Click="HomeButton_Click" MinWidth="160" MinHeight="50" Background="#142545" Foreground="White" FontSize="16"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
