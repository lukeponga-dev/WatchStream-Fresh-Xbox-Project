<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Release signing and installer generation are opt-in; supply the real publisher identity and HTTPS host in a protected release pipeline. -->
    <AppxPackageSigningEnabled Condition="'$(WatchStreamReleaseSigningEnabled)' == 'true'">true</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="'$(WatchStreamReleaseSigningEnabled)' != 'true'">false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile Condition="'$(WatchStreamReleaseInstallerEnabled)' == 'true'">true</GenerateAppInstallerFile>
    <GenerateAppInstallerFile Condition="'$(WatchStreamReleaseInstallerEnabled)' != 'true'">false</GenerateAppInstallerFile>
    <PackageCertificateKeyFile Condition="'$(WatchStreamSigningCertificate)' != ''">$(WatchStreamSigningCertificate)</PackageCertificateKeyFile>
    <AppInstallerUri Condition="'$(WatchStreamReleaseInstallerUri)' != ''">$(WatchStreamReleaseInstallerUri)</AppInstallerUri>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Auto</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <DefineConstants Condition="'$(WatchStreamAddonDirectoryPermissionGranted)' == 'true'">$(DefineConstants);WATCHSTREAM_ADDON_DIRECTORY_PERMISSION_GRANTED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WatchStream.Core\WatchStream.Core.csproj" />
    <ProjectReference Include="..\WatchStream.Application\WatchStream.Application.csproj" />
    <ProjectReference Include="..\WatchStream.Domain\WatchStream.Domain.csproj" />
    <ProjectReference Include="..\WatchStream.Infrastructure\WatchStream.Infrastructure.csproj" />
    <Compile Include="..\WatchStream.Platform.Xbox\XboxMediaPlayer.cs" Link="Platform\XboxMediaPlayer.cs" />
  </ItemGroup>
</Project>
