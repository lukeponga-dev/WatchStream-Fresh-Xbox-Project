<Page
    x:Class="WatchStream.Xbox.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#050B1B" Foreground="#F5F7FF" Loaded="Page_Loaded">
    <Grid Padding="26,22,26,20" ColumnSpacing="24" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#07142A" BorderBrush="#183B70" BorderThickness="1" CornerRadius="18" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="11" Background="#5268FF"><TextBlock Text="W" FontSize="25" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1"><TextBlock Text="WATCHSTREAM" FontSize="17" FontWeight="Bold" CharacterSpacing="55"/><TextBlock Text="YOUR MEDIA, YOUR WAY" FontSize="9" Foreground="#9BA8C7" CharacterSpacing="75"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock Text="MENU" FontSize="11" FontWeight="Bold" Foreground="#7181A2" CharacterSpacing="160" Margin="10,0,0,5"/>
                    <Button x:Name="HomeButton" Content="⌂   Home" Click="HomeButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="50" HorizontalContentAlignment="Left" Padding="14,0" FontSize="17" Background="#10264B" Foreground="#F5F7FF" TabIndex="0" UseSystemFocusVisuals="True"/>
                    <Button x:Name="SearchNavButton" Content="⌕   Search" Click="SearchTabButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="50" HorizontalContentAlignment="Left" Padding="14,0" FontSize="17" Background="#10264B" Foreground="#F5F7FF" TabIndex="1" UseSystemFocusVisuals="True"/>
                    <Button x:Name="LibraryNavButton" Content="▤   My Library" Click="LibraryTabButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="50" HorizontalContentAlignment="Left" Padding="14,0" FontSize="17" Background="#5268FF" Foreground="#FFFFFF" TabIndex="2" UseSystemFocusVisuals="True"/>
                    <Button x:Name="DiscoverNavButton" Content="✦   Discover" Click="DiscoverTabButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="50" HorizontalContentAlignment="Left" Padding="14,0" FontSize="17" Background="#10264B" Foreground="#F5F7FF" TabIndex="3" UseSystemFocusVisuals="True"/>
                    <Button x:Name="SeriesNavButton" Content="▣   Series" Click="SeriesButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="50" HorizontalContentAlignment="Left" Padding="14,0" FontSize="17" Background="#10264B" Foreground="#F5F7FF" TabIndex="4" UseSystemFocusVisuals="True"/>
                    <Button x:Name="AddonsNavButton" Content="▦   Add-ons" Click="AddonsButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="50" HorizontalContentAlignment="Left" Padding="14,0" FontSize="17" Background="#10264B" Foreground="#F5F7FF" TabIndex="5" UseSystemFocusVisuals="True"/>
                    <Button x:Name="ConnectNavButton" Content="↔   Connect Stremio" Click="ConnectButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="50" HorizontalContentAlignment="Left" Padding="14,0" FontSize="16" Background="#10264B" Foreground="#F5F7FF" TabIndex="6" UseSystemFocusVisuals="True"/>
                    <Button x:Name="SettingsNavButton" Content="⚙   Settings" Click="SettingsButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinHeight="50" HorizontalContentAlignment="Left" Padding="14,0" FontSize="17" Background="#10264B" Foreground="#F5F7FF" TabIndex="7" UseSystemFocusVisuals="True"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Spacing="5"><Border Height="1" Background="#183B70" Margin="0,0,0,8"/><TextBlock Text="D-PAD / LEFT STICK" FontSize="10" Foreground="#7181A2"/><TextBlock Text="A SELECT   •   B BACK" FontSize="10" Foreground="#7181A2"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowSpacing="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Spacing="5">
                <TextBlock x:Name="PageTitle" Text="My Library" FontSize="36" FontWeight="Bold"/>
                <TextBlock x:Name="PageSubtitle" Text="Your saved movies and series" FontSize="16" Foreground="#A9B5D1" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Row="1" CornerRadius="20" Background="#07152F" BorderBrush="#183B70" BorderThickness="1" Padding="18">
                <Grid>
                    <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                        <ProgressRing IsActive="True" Width="58" Height="58"/><TextBlock x:Name="LoadingText" Text="Loading catalog…" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Please wait" FontSize="15" Foreground="#9BA8C7" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650" Spacing="16">
                        <Border Width="84" Height="84" CornerRadius="42" Background="#14285A" HorizontalAlignment="Center"><TextBlock x:Name="EmptyIcon" Text="▤" FontSize="42" Foreground="#5268FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock x:Name="EmptyTitle" Text="Your library is waiting" FontSize="28" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="EmptyDescription" Text="Connect a supported account or catalog source to see your saved titles here." FontSize="17" Foreground="#B7C2DC" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="ConnectAccountButton" Content="Connect Stremio" Click="ConnectButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinWidth="180" MinHeight="52" FontSize="17" Background="#5268FF" Foreground="#FFFFFF" TabIndex="6" UseSystemFocusVisuals="True"/>
                            <Button x:Name="RefreshButton" Content="Try again" Click="RefreshButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinWidth="140" MinHeight="52" FontSize="17" Background="#10264B" Foreground="#F5F7FF" TabIndex="7" UseSystemFocusVisuals="True"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650" Spacing="16">
                        <TextBlock Text="!" FontSize="54" FontWeight="Bold" Foreground="#FF8FA3" HorizontalAlignment="Center"/><TextBlock Text="We couldn't load this section" FontSize="27" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ErrorDescription" Text="Check your connection and try again." FontSize="17" Foreground="#B7C2DC" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="RetryButton" Content="Retry" Click="ErrorActionButton_Click" GotFocus="Control_GotFocus" LostFocus="Control_LostFocus" MinWidth="170" MinHeight="54" FontSize="17" Background="#5268FF" Foreground="#FFFFFF" IsTabStop="True" TabIndex="8" UseSystemFocusVisuals="True"/>
                    </StackPanel>
                    <Grid x:Name="ResultsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                            <Button x:Name="AllFilterButton" Content="All" Click="AllFilterButton_Click" MinWidth="82" MinHeight="42" Background="#5268FF" Foreground="#FFFFFF" TabIndex="6" UseSystemFocusVisuals="True"/>
                            <Button x:Name="MoviesFilterButton" Content="Movies" Click="MoviesFilterButton_Click" MinWidth="100" MinHeight="42" Background="#10264B" Foreground="#F5F7FF" TabIndex="7" UseSystemFocusVisuals="True"/>
                            <Button x:Name="SeriesFilterButton" Content="Series" Click="SeriesFilterButton_Click" MinWidth="100" MinHeight="42" Background="#10264B" Foreground="#F5F7FF" TabIndex="8" UseSystemFocusVisuals="True"/>
                            <TextBox x:Name="SearchBox" PlaceholderText="Search titles" MinWidth="190" MinHeight="42" TextChanged="SearchBox_TextChanged" TabIndex="9" UseSystemFocusVisuals="True"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <TextBlock x:Name="FilteredEmptyText" Text="No matching titles. Try another filter or search." FontSize="19" Foreground="#A9B5D1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="MediaScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <GridView x:Name="MediaGrid" IsItemClickEnabled="True" ItemClick="MediaGrid_ItemClick" SelectionMode="None" IsTabStop="False" TabNavigation="Once">
                                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/></ItemsPanelTemplate></GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="MediaCard_Click" MinWidth="145" Width="145" Height="258" Padding="8" Margin="0,0,8,10" Background="#101F3A" BorderBrush="#183B70" BorderThickness="1" UseSystemFocusVisuals="True">
                                            <StackPanel Spacing="7">
                                                <Grid Width="125" Height="172" Background="#243451">
                                                    <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
                                                    <TextBlock Text="WATCHSTREAM" FontSize="10" Foreground="#DDE6FF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" Height="40"/>
                                                <TextBlock Text="{Binding Year}" FontSize="12" Foreground="#9BA8C7"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready" FontSize="13" Foreground="#9BA8C7" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="WATCHSTREAM  •  XBOX ONE" FontSize="11" Foreground="#657493" VerticalAlignment="Center"/></Grid>
        </Grid>
        <Grid x:Name="DetailsOverlay" Grid.ColumnSpan="2" Background="#050B1B" Visibility="Collapsed" Padding="28">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Button x:Name="DetailsBackButton" Content="‹   Back to results" Click="DetailsBackButton_Click" HorizontalAlignment="Left" MinHeight="46" Padding="16,0" Background="#10264B" Foreground="White" TabIndex="20"/>
                <Border Grid.Row="1" Background="#08152E" BorderBrush="#183B70" BorderThickness="1" CornerRadius="18" Padding="24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#14285A" CornerRadius="12" Clip="True"><Image x:Name="DetailsPoster" Stretch="UniformToFill"/></Border>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <TextBlock Text="TITLE DETAILS" FontSize="12" FontWeight="Bold" Foreground="#39D6C5" CharacterSpacing="150"/>
                                <TextBlock x:Name="DetailsTitle" FontSize="36" FontWeight="Bold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock x:Name="DetailsYear" FontSize="15" Foreground="#B7C2DC"/><TextBlock Text="•" Foreground="#7181A2"/><TextBlock x:Name="DetailsType" FontSize="15" Foreground="#B7C2DC"/></StackPanel>
                                <TextBlock x:Name="DetailsDescription" FontSize="17" Foreground="#D5DDF1" TextWrapping="Wrap"/>
                                <TextBlock Text="WATCH OPTIONS" FontSize="12" FontWeight="Bold" Foreground="#39D6C5" CharacterSpacing="130" Margin="0,10,0,0"/>
                                <Border Background="#101F3A" BorderBrush="#183B70" BorderThickness="1" CornerRadius="10" Padding="16">
                                    <StackPanel Spacing="8"><TextBlock Text="Streaming sources" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="DetailsSourceStatus" Text="Compatible Stremio add-ons are needed to find streams." FontSize="14" Foreground="#A9B5D1" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="DetailsPlayButton" Content="▶   Find streams" Click="DetailsPlayButton_Click" MinWidth="170" MinHeight="52" FontSize="16" Background="#5268FF" Foreground="White" TabIndex="21"/><Button Content="＋   Add to Library" Click="DetailsLibraryButton_Click" MinWidth="165" MinHeight="52" FontSize="16" Background="#10264B" Foreground="White" TabIndex="22"/></StackPanel>
                                <TextBlock x:Name="DetailsActionStatus" FontSize="14" Foreground="#9BA8C7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>