<Page
    x:Class="WatchStream.Xbox.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WatchStream.Xbox"
    Background="#050B1B"
    Foreground="#F4F6FB"
    Loaded="Page_Loaded">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#E50914" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9BA5B5" />

        <Style x:Key="CatalogCardButtonStyle" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CardContent" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E50914" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="Glow" BorderBrush="#E50914" BorderThickness="3" CornerRadius="12" Opacity="0" Margin="5"/>
                            <Grid x:Name="CardContent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <ContentPresenter />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid ColumnSpacing="0" XYFocusKeyboardNavigation="Enabled">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NavigationSidebar x:Name="PageSidebar" Grid.Column="0" CurrentSection="Discover"/>
        <Grid Grid.Column="1" Padding="44,36,44,42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,40">
            <TextBlock x:Name="CategoryTitle" Text="Discover" FontSize="46" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="CategoryDesc" Text="Explore the latest content from your add-ons" FontSize="19" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                <TextBox x:Name="SearchBox" Width="480" MinHeight="54" FontSize="18" PlaceholderText="Search movies and series" />
                <Button Content="Search" Click="SearchButton_Click" MinWidth="140" MinHeight="54" Background="#5268FF" Foreground="White" FontSize="17"/>
            </StackPanel>
        </StackPanel>

        <!-- Content Grid -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="CatalogSectionsScrollViewer" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CatalogSectionsPanel" Spacing="26" Padding="0,0,0,24" />
            </ScrollViewer>
            <ScrollViewer x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <GridView x:Name="MediaGrid"
                          IsItemClickEnabled="False"
                          SelectionMode="None"
                          XYFocusKeyboardNavigation="Enabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CatalogCardButtonStyle}" Width="200" Height="290" Margin="12" Click="MediaCard_Click">
                                <Grid>
                                    <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" Width="200" Height="290"/>
                                    <Border Background="#99000000" VerticalAlignment="Bottom" Height="72" CornerRadius="0,0,12,12" Padding="12,0,12,0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </ScrollViewer>
            <Border x:Name="StatePanel" Visibility="Collapsed" Background="#101B30" BorderBrush="#294365"
                    BorderThickness="1" CornerRadius="14" Padding="32" MaxWidth="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing x:Name="StateProgressRing" Width="44" Height="44" IsActive="False"
                                  Visibility="Collapsed" Foreground="#39D6C5" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StateTitle" Text="Loading" FontSize="24" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StateMessage" Text="Please wait…" FontSize="16" Foreground="#9BA8C7"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                    <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click"
                            Visibility="Collapsed" MinWidth="150" MinHeight="48" Background="#5268FF"
                            Foreground="White" BorderThickness="0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Page>
